#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker awscli amazon-cloudwatch-agent

cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'EOF'
{
  "agent": {
    "metrics_collection_interval": 60
  },
  "metrics": {
    "namespace": "AIPost/EC2",
    "append_dimensions": {
      "InstanceId": "$${aws:InstanceId}",
      "AutoScalingGroupName": "$${aws:AutoScalingGroupName}"
    },
    "aggregation_dimensions": [
      ["AutoScalingGroupName"]
    ],
    "metrics_collected": {
      "mem": {
        "measurement": [
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "resources": [
          "/"
        ],
        "metrics_collection_interval": 60
      }
    }
  }
}
EOF

# Start CloudWatch Agent with json file
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config \
  -m ec2 \
  -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json

systemctl enable docker
systemctl start docker

aws ecr get-login-password --region ${aws_region} \
  | docker login \
    --username AWS \
    --password-stdin \
    $(echo "${ecr_repository_url}" | cut -d/ -f1)

IMAGE_TAG=$(aws ssm get-parameter \
  --name "${ssm_parameter_prefix}/IMAGE_TAG" \
  --region "${aws_region}" \
  --query 'Parameter.Value' \
  --output text)

IMAGE_URI="${ecr_repository_url}:$IMAGE_TAG"

docker pull "$IMAGE_URI"

docker rm -f aipost-backend || true

DATABASE_URL=$(aws ssm get-parameter \
  --name "${ssm_parameter_prefix}/DATABASE_URL" \
  --with-decryption \
  --region "${aws_region}" \
  --query "Parameter.Value" \
  --output text)

ENCRYPTION_KEY=$(aws ssm get-parameter \
  --name "${ssm_parameter_prefix}/ENCRYPTION_KEY" \
  --with-decryption \
  --region "${aws_region}" \
  --query "Parameter.Value" \
  --output text)

docker run -d \
  --name aipost-backend \
  --restart unless-stopped \
  --log-driver=awslogs \
  --log-opt awslogs-region="${aws_region}" \
  --log-opt awslogs-group="${cloudwatch_log_group_name}" \
  --log-opt awslogs-stream="backend/$(hostname)" \
  -p ${backend_port}:${backend_port} \
  -e PORT="${backend_port}" \
  -e NODE_ENV="production" \
  -e DATABASE_URL="$DATABASE_URL" \
  -e ENCRYPTION_KEY="$ENCRYPTION_KEY" \
  -e CORS_ORIGINS="${cors_origins}" \
  -e MEDIA_STORAGE_PROVIDER="${media_storage_provider}" \
  -e MEDIA_PUBLIC_BASE_URL="${media_public_base_url}" \
  -e S3_BUCKET_NAME="${s3_bucket_name}" \
  -e AWS_REGION="${aws_region}" \
  -e SSM_PARAMETER_PREFIX="${ssm_parameter_prefix}" \
  "$IMAGE_URI" 